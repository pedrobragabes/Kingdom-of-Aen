{
  "name": "kingdom-of-aen",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate-project.js --strict",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check \"js/**/*.js\" \"scripts/*.{js,mjs}\" \"tests/**/*.js\" \"e2e/**/*.js\" \"css/*.css\" \"*.{js,json,html}\" \".github/**/*.yml\""
  },
